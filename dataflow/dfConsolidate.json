{
	"name": "dfConsolidate",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_adls_fen2_csv",
						"type": "DatasetReference"
					},
					"name": "dfsrcEmployeeInfoFromHR"
				},
				{
					"dataset": {
						"referenceName": "ds_adls_fen2_csv",
						"type": "DatasetReference"
					},
					"name": "dfsrcEmployeeProjectAllocationFromRDG"
				},
				{
					"dataset": {
						"referenceName": "ds_adls_gen2_json",
						"type": "DatasetReference"
					},
					"name": "dfSrcEmployeeStack"
				},
				{
					"dataset": {
						"referenceName": "ds_adls_fen2_csv",
						"type": "DatasetReference"
					},
					"name": "dfSrcEmployeeDesignationFromTA"
				},
				{
					"dataset": {
						"referenceName": "ds_adls_fen2_csv",
						"type": "DatasetReference"
					},
					"name": "dfSrcEmployeeShiftAllotment"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_azSQLdb",
						"type": "DatasetReference"
					},
					"name": "azSqltbl"
				}
			],
			"transformations": [
				{
					"name": "dfSrcEmployeeProjectAllocationFromRDGOutput"
				},
				{
					"name": "select1"
				},
				{
					"name": "tillEmployeeStack"
				},
				{
					"name": "select2"
				},
				{
					"name": "tillEmployeeDesignationFromTA"
				},
				{
					"name": "select3"
				},
				{
					"name": "tillEmployeeShiftAllotment"
				},
				{
					"name": "select4"
				},
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          Emp_id as short,",
				"          {First Name} as string,",
				"          {Last Name} as string,",
				"          Age as short,",
				"          Band as short,",
				"          Phone as string,",
				"          Email as string,",
				"          State as string,",
				"          City as string,",
				"          Flage as boolean,",
				"          DOJ as string,",
				"          DateOfLeaving as string,",
				"          EffectiveFrom as string,",
				"          EffectiveTo as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> dfsrcEmployeeInfoFromHR",
				"source(output(",
				"          Emp_id as short,",
				"          DepartmentName as string,",
				"          Client_name as string,",
				"          Client_city as string,",
				"          Client_contry as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> dfsrcEmployeeProjectAllocationFromRDG",
				"source(output(",
				"          Emp_id as short,",
				"          Stack_Layer as string,",
				"          Tools_Technologies as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     documentForm: 'arrayOfDocuments') ~> dfSrcEmployeeStack",
				"source(output(",
				"          Emp_id as short,",
				"          Designation_Categary as string,",
				"          Designation as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> dfSrcEmployeeDesignationFromTA",
				"source(output(",
				"          Emp_id as short,",
				"          {Shift Type} as string,",
				"          Shift_start_hr as string,",
				"          Shift_end as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> dfSrcEmployeeShiftAllotment",
				"dfsrcEmployeeInfoFromHR, dfsrcEmployeeProjectAllocationFromRDG join(dfsrcEmployeeInfoFromHR@Emp_id == dfsrcEmployeeProjectAllocationFromRDG@Emp_id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> dfSrcEmployeeProjectAllocationFromRDGOutput",
				"dfSrcEmployeeProjectAllocationFromRDGOutput select(mapColumn(",
				"          Emp_id = dfsrcEmployeeInfoFromHR@Emp_id,",
				"          {First Name},",
				"          {Last Name},",
				"          Age,",
				"          Band,",
				"          Phone,",
				"          Email,",
				"          State,",
				"          City,",
				"          Flage,",
				"          DOJ,",
				"          DateOfLeaving,",
				"          EffectiveFrom,",
				"          EffectiveTo,",
				"          Emp_id = dfsrcEmployeeProjectAllocationFromRDG@Emp_id,",
				"          DepartmentName,",
				"          Client_name,",
				"          Client_city,",
				"          Client_contry",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1, dfSrcEmployeeStack join(select1@Emp_id == dfSrcEmployeeStack@Emp_id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> tillEmployeeStack",
				"tillEmployeeStack select(mapColumn(",
				"          Emp_id = select1@Emp_id,",
				"          {First Name},",
				"          {Last Name},",
				"          Age,",
				"          Band,",
				"          Phone,",
				"          Email,",
				"          State,",
				"          City,",
				"          Flage,",
				"          DOJ,",
				"          DateOfLeaving,",
				"          EffectiveFrom,",
				"          EffectiveTo,",
				"          DepartmentName,",
				"          Client_name,",
				"          Client_city,",
				"          Client_contry,",
				"          Emp_id = dfSrcEmployeeStack@Emp_id,",
				"          Stack_Layer,",
				"          Tools_Technologies",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"select2, dfSrcEmployeeDesignationFromTA join(select2@Emp_id == dfSrcEmployeeDesignationFromTA@Emp_id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> tillEmployeeDesignationFromTA",
				"tillEmployeeDesignationFromTA select(mapColumn(",
				"          Emp_id = select2@Emp_id,",
				"          {First Name},",
				"          {Last Name},",
				"          Age,",
				"          Band,",
				"          Phone,",
				"          Email,",
				"          State,",
				"          City,",
				"          Flage,",
				"          DOJ,",
				"          DateOfLeaving,",
				"          EffectiveFrom,",
				"          EffectiveTo,",
				"          DepartmentName,",
				"          Client_name,",
				"          Client_city,",
				"          Client_contry,",
				"          Stack_Layer,",
				"          Tools_Technologies,",
				"          Emp_id = dfSrcEmployeeDesignationFromTA@Emp_id,",
				"          Designation_Categary,",
				"          Designation",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select3",
				"select3, dfSrcEmployeeShiftAllotment join(select3@Emp_id == dfSrcEmployeeShiftAllotment@Emp_id,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> tillEmployeeShiftAllotment",
				"tillEmployeeShiftAllotment select(mapColumn(",
				"          Emp_id = select3@Emp_id,",
				"          {First Name},",
				"          {Last Name},",
				"          Age,",
				"          Band,",
				"          Phone,",
				"          Email,",
				"          State,",
				"          City,",
				"          Flage,",
				"          DOJ,",
				"          DateOfLeaving,",
				"          EffectiveFrom,",
				"          EffectiveTo,",
				"          DepartmentName,",
				"          Client_name,",
				"          Client_city,",
				"          Client_contry,",
				"          Stack_Layer,",
				"          Tools_Technologies,",
				"          Designation_Categary,",
				"          Designation,",
				"          Emp_id = dfSrcEmployeeShiftAllotment@Emp_id,",
				"          {Shift Type},",
				"          Shift_start_hr,",
				"          Shift_end",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select4",
				"select4 derive(Load_dt = currentTimestamp(),",
				"          DOJ_dr = toDate(\r",
				"    toString(DOJ,'dd-MM-yyyy'),\r",
				"    'dd-MM-yyyy'\r",
				"),",
				"          DateOfLeaving_dr = toDate(toString(DateOfLeaving,'dd-MM-yyyy'),'dd-MM-yyyy'),",
				"          EffectiveFrom_dr = toDate(toString(EffectiveFrom,'dd-MM-yyyy'),'dd-MM-yyyy'),",
				"          EffectiveTo_dr = toDate(toString(EffectiveTo,'dd-MM-yyyy'),'dd-MM-yyyy')) ~> derivedColumn1",
				"derivedColumn1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     truncate:true,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          Emp_id,",
				"          {First Name},",
				"          {Last Name},",
				"          Age,",
				"          Band,",
				"          Phone,",
				"          Email,",
				"          State,",
				"          City,",
				"          Flage,",
				"          DepartmentName,",
				"          Client_name,",
				"          Client_city,",
				"          Client_contry,",
				"          Stack_Layer,",
				"          Tools_Technologies,",
				"          Designation_Categary,",
				"          Designation,",
				"          {Shift Type},",
				"          Shift_start_hr,",
				"          Shift_end,",
				"          Load_dt,",
				"          DOJ = DOJ_dr,",
				"          DateOfLeaving = DateOfLeaving_dr,",
				"          EffectiveFrom = EffectiveFrom_dr,",
				"          EffectiveTo = EffectiveTo_dr",
				"     )) ~> azSqltbl"
			]
		}
	}
}