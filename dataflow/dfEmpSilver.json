{
	"name": "dfEmpSilver",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_azSQLdb",
						"type": "DatasetReference"
					},
					"name": "srcConsolidate"
				},
				{
					"dataset": {
						"referenceName": "ds_azSQLdb",
						"type": "DatasetReference"
					},
					"name": "trgtdimemp"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_azSQLdb",
						"type": "DatasetReference"
					},
					"name": "sinkSilverEmp"
				},
				{
					"dataset": {
						"referenceName": "ds_azSQLdb",
						"type": "DatasetReference"
					},
					"name": "sinksilverscd01"
				},
				{
					"dataset": {
						"referenceName": "ds_azSQLdb",
						"type": "DatasetReference"
					},
					"name": "sink1"
				},
				{
					"dataset": {
						"referenceName": "ds_azSQLdb",
						"type": "DatasetReference"
					},
					"name": "sink2"
				}
			],
			"transformations": [
				{
					"name": "select1"
				},
				{
					"name": "join1"
				},
				{
					"name": "select2"
				},
				{
					"name": "split1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "alterRow1"
				},
				{
					"name": "existsScd01"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "alterRow2"
				},
				{
					"name": "exists1"
				},
				{
					"name": "scd02"
				},
				{
					"name": "scd02expired"
				},
				{
					"name": "alterRow3"
				},
				{
					"name": "select3"
				},
				{
					"name": "scd02New"
				},
				{
					"name": "alterRow4"
				},
				{
					"name": "select4"
				}
			],
			"scriptLines": [
				"source(output(",
				"          Emp_id as short,",
				"          {First Name} as string,",
				"          {Last Name} as string,",
				"          Age as short,",
				"          Band as short,",
				"          Phone as string,",
				"          Email as string,",
				"          State as string,",
				"          City as string,",
				"          Flage as boolean,",
				"          DOJ as date,",
				"          DateOfLeaving as date,",
				"          EffectiveFrom as date,",
				"          EffectiveTo as date,",
				"          DepartmentName as string,",
				"          Client_name as string,",
				"          Client_city as string,",
				"          Client_contry as string,",
				"          Stack_Layer as string,",
				"          Tools_Technologies as string,",
				"          Designation_Categary as string,",
				"          Designation as string,",
				"          {Shift Type} as string,",
				"          Shift_start_hr as string,",
				"          Shift_end as string,",
				"          Load_dt as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> srcConsolidate",
				"source(output(",
				"          EmployeeSK as integer,",
				"          Emp_id as integer,",
				"          First_Name as string,",
				"          Last_Name as string,",
				"          Age as integer,",
				"          Band as string,",
				"          Phone as string,",
				"          Email as string,",
				"          State as string,",
				"          City as string,",
				"          Flage as string,",
				"          DOJ as date,",
				"          DateOfLeaving as date,",
				"          EffectiveFrom as date,",
				"          EffectiveTo as date,",
				"          Load_dt as timestamp,",
				"          modify_dt as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'select * from gold.Dim_Employee',",
				"     format: 'query') ~> trgtdimemp",
				"srcConsolidate select(mapColumn(",
				"          Emp_id,",
				"          {First Name},",
				"          {Last Name},",
				"          Age,",
				"          Band,",
				"          Phone,",
				"          Email,",
				"          State,",
				"          City,",
				"          Flage,",
				"          DOJ,",
				"          DateOfLeaving,",
				"          EffectiveFrom,",
				"          EffectiveTo",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1, trgtdimemp join(select1@Emp_id == trgtdimemp@Emp_id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"join1 select(mapColumn(",
				"          Emp_id = select1@Emp_id,",
				"          First_Name = {First Name},",
				"          Last_Name = {Last Name},",
				"          Age = select1@Age,",
				"          Band = select1@Band,",
				"          Phone = select1@Phone,",
				"          Email = select1@Email,",
				"          State = select1@State,",
				"          City = select1@City,",
				"          Flage = select1@Flage,",
				"          DOJ = select1@DOJ,",
				"          DateOfLeaving = select1@DateOfLeaving,",
				"          EffectiveFrom = select1@EffectiveFrom,",
				"          EffectiveTo = select1@EffectiveTo,",
				"          EmployeeSK_tgt = EmployeeSK,",
				"          Emp_id_tgt = trgtdimemp@Emp_id",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"select2 split(isNull(Emp_id_tgt),",
				"     disjoint: false) ~> split1@(NewRecord, ExistingRecords)",
				"split1@NewRecord derive(Load_dt = currentTimestamp()) ~> derivedColumn1",
				"derivedColumn1 alterRow(insertIf(true())) ~> alterRow1",
				"split1@ExistingRecords, trgtdimemp exists(split1@ExistingRecords@Phone!=trgtdimemp@Phone,",
				"     negate:false,",
				"     broadcast: 'auto')~> existsScd01",
				"existsScd01 derive(Modify_dt = currentTimestamp()) ~> derivedColumn2",
				"derivedColumn2 alterRow(insertIf(true())) ~> alterRow2",
				"split1@ExistingRecords, trgtdimemp exists(trgtdimemp@Band!=toString(split1@ExistingRecords@Band),",
				"     negate:false,",
				"     broadcast: 'auto')~> exists1",
				"exists1 select(mapColumn(",
				"          Emp_id,",
				"          EmployeeSK_tgt,",
				"          First_Name,",
				"          Last_Name,",
				"          Age,",
				"          Band,",
				"          Phone,",
				"          Email,",
				"          State,",
				"          City,",
				"          Flage,",
				"          DOJ,",
				"          DateOfLeaving,",
				"          EffectiveFrom,",
				"          EffectiveTo",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> scd02",
				"scd02 derive(modify_dt = currentTimestamp(),",
				"          Flage = \"N\",",
				"          EffectiveTo = currentTimestamp()-1) ~> scd02expired",
				"select3 alterRow(insertIf(true())) ~> alterRow3",
				"scd02expired select(mapColumn(",
				"          Emp_id,",
				"          First_Name,",
				"          Last_Name,",
				"          Age,",
				"          Band,",
				"          Phone,",
				"          Email,",
				"          State,",
				"          City,",
				"          Flage,",
				"          DOJ,",
				"          DateOfLeaving,",
				"          EffectiveFrom,",
				"          EffectiveTo,",
				"          modify_dt",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select3",
				"select4 derive(Load_dt = currentTimestamp(),",
				"          Flage = \"Y\",",
				"          EffectiveFrom = currentTimestamp(),",
				"          EffectiveTo = toDate('1999-01-01')) ~> scd02New",
				"scd02New alterRow(insertIf(true())) ~> alterRow4",
				"scd02 select(mapColumn(",
				"          Emp_id,",
				"          First_Name,",
				"          Last_Name,",
				"          Age,",
				"          Band,",
				"          Phone,",
				"          Email,",
				"          State,",
				"          City,",
				"          Flage,",
				"          DOJ,",
				"          DateOfLeaving,",
				"          EffectiveFrom,",
				"          EffectiveTo",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select4",
				"alterRow1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     truncate:true,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          Emp_id,",
				"          First_Name,",
				"          Last_Name,",
				"          Age,",
				"          Band,",
				"          Phone,",
				"          Email,",
				"          State,",
				"          City,",
				"          Flage,",
				"          DOJ,",
				"          DateOfLeaving,",
				"          EffectiveFrom,",
				"          EffectiveTo,",
				"          Load_dt",
				"     )) ~> sinkSilverEmp",
				"alterRow2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     truncate:true,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          Emp_id,",
				"          First_Name,",
				"          Last_Name,",
				"          Age,",
				"          Band,",
				"          Phone,",
				"          Email,",
				"          State,",
				"          City,",
				"          Flage,",
				"          DOJ,",
				"          DateOfLeaving,",
				"          EffectiveFrom,",
				"          EffectiveTo,",
				"          EmployeeSK = EmployeeSK_tgt,",
				"          Modify_dt",
				"     )) ~> sinksilverscd01",
				"alterRow3 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     truncate:true,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1",
				"alterRow4 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     truncate:true,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink2"
			]
		}
	}
}