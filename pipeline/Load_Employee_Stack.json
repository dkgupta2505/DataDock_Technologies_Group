{
	"name": "Load_Employee_Stack",
	"properties": {
		"activities": [
			{
				"name": "ds_getfileInfo_onprem",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "ds_onPremFile",
						"type": "DatasetReference"
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "FileServerReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "JsonReadSettings"
					}
				}
			},
			{
				"name": "Filter_Employee_Stack",
				"type": "Filter",
				"dependsOn": [
					{
						"activity": "ds_getfileInfo_onprem",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('ds_getfileInfo_onprem').output.childItems",
						"type": "Expression"
					},
					"condition": {
						"value": "@equals(item().name,'Employee_Stack.json')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Get_lastModificationDT",
				"type": "GetMetadata",
				"dependsOn": [
					{
						"activity": "Filter_Employee_Stack",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "ds_onprem_file_json",
						"type": "DatasetReference",
						"parameters": {
							"filename": {
								"value": "@{pipeline().parameters.cc_p_Employee_Stack}.json",
								"type": "Expression"
							}
						}
					},
					"fieldList": [
						"lastModified"
					],
					"storeSettings": {
						"type": "FileServerReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "JsonReadSettings"
					}
				}
			},
			{
				"name": "checking_existing",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "Get_lastModificationDT",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "select sum(cnt) as cnt from  \n(select 1 as cnt\nfrom dbo.file_process_log_tbl \nwhere file_name='@{activity('Filter_Employee_Stack').output.value[0].name}' and \nsrc_file_modify_dt='@{activity('Get_lastModificationDT').output.lastModified}'\nunion all\nselect 1  )t1",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "ds_azSQLdb",
						"type": "DatasetReference",
						"parameters": {
							"schema_name": "dbo",
							"tablename": "file_process_log_tbl"
						}
					}
				}
			},
			{
				"name": "If Condition1",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "checking_existing",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@equals(activity('checking_existing').output.firstRow.cnt, 1)\n",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "Employee_Stack_load",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "JsonSource",
									"storeSettings": {
										"type": "FileServerReadSettings",
										"recursive": true,
										"enablePartitionDiscovery": false
									},
									"formatSettings": {
										"type": "JsonReadSettings"
									}
								},
								"sink": {
									"type": "JsonSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "JsonWriteSettings"
									}
								},
								"enableStaging": false
							},
							"inputs": [
								{
									"referenceName": "ds_onprem_file_json",
									"type": "DatasetReference",
									"parameters": {
										"filename": {
											"value": "@{activity('Filter_Employee_Stack').output.Value[0].name}",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "ds_adls_gen2_json",
									"type": "DatasetReference",
									"parameters": {
										"filename": {
											"value": "@{substring(activity('Filter_Employee_Stack').output.value[0].name,0,indexOf(activity('Filter_Employee_Stack').output.value[0].name,'.'))}_@{formatDateTime(utcNow(),'yyyMMdd')}.json",
											"type": "Expression"
										}
									}
								}
							]
						},
						{
							"name": "log_transaction",
							"type": "Script",
							"dependsOn": [
								{
									"activity": "Employee_Stack_load",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"linkedServiceName": {
								"referenceName": "linkedService_azSQLdb",
								"type": "LinkedServiceReference"
							},
							"typeProperties": {
								"scripts": [
									{
										"type": "Query",
										"text": {
											"value": "INSERT INTO dbo.file_process_log_tbl\n(\n    batch_id,\n    file_name,\n    src_file_modify_dt,\n    load_dt\n)\nSELECT\n    @{pipeline().parameters.cc_p_batch_id} AS batch_id,\n  '@{activity('Filter_Employee_Stack').output.value[0].name}' as file_name,\n'@{activity('Get_lastModificationDT').output.lastModified}' as last_modification_dt,\n    '@{utcNow('yyyy-MM-dd HH:mm:ss')}' AS load_dt;",
											"type": "Expression"
										}
									}
								],
								"scriptBlockExecutionTimeout": "02:00:00"
							}
						}
					]
				}
			}
		],
		"parameters": {
			"cc_p_Employee_Stack": {
				"type": "string"
			},
			"cc_p_batch_id": {
				"type": "int"
			}
		},
		"annotations": []
	}
}